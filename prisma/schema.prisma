// Studio Masons ERP — Prisma Schema
generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  // "native" for local dev; "rhel-openssl-3.0.x" is the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DESIGNER
  SITE_ENGINEER
  FINANCE
  CLIENT
  SENIOR_QS
  PROCUREMENT_MANAGER
  PROJECT_DIRECTOR
}

// Stages a Purchase Intent moves through, from the Project Manager raising it to
// the Procurement Manager releasing the PO. See procurement.ts for the gating that
// drives the PD reconfirmation step when an intent exceeds the budget BOQ.
enum IntentStatus {
  PENDING_PD_APPROVAL
  PD_REJECTED
  PD_APPROVED
  QUOTES_PENDING
  COMPARISON_PENDING_PD
  PENDING_FINANCE
  FINANCE_APPROVED
  PO_RELEASED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum DesignFileStatus {
  PENDING_REVIEW
  APPROVED_INTERNALLY
  CLIENT_APPROVED
  CHANGES_REQUESTED
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SnagPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum ERPSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// The two ownership zones of the project pipeline. CONCEPT owns stages 1–11
// (proposing → GFC), PROJECT owns stages 12–14 (kickoff → change orders). The
// Stage 11→12 transition is the gated handoff between them.
enum StageZone {
  CONCEPT
  PROJECT
}

// Leadership colour logic from the Design Operating System deck:
// ON_TRACK=green, SUBMITTED=blue (awaiting approval), DELAY_RISK=amber
// (dependency pending), DELAYED=red (decision required), ON_HOLD=grey.
// NOT_STARTED (neutral default) and DONE (gate cleared) bookend the lifecycle.
enum StageStatus {
  NOT_STARTED
  ON_TRACK
  SUBMITTED
  DELAY_RISK
  DELAYED
  ON_HOLD
  DONE
}

model User {
  id         String   @id @default(cuid())
  supabaseId String?  @unique
  email      String   @unique
  name       String
  role       Role
  avatarUrl  String?
  // Design sub-team tag used by the Project Tracker lead/helper pickers.
  // One of "Concept" | "Project" | "Site" (null = untagged).
  team       String?
  createdAt  DateTime @default(now())

  assignedSnags   Snag[]        @relation("SnagAssignee")
  uploadedDesigns DesignFile[]
  surveys         SiteSurvey[]
  activityLogs    ActivityLog[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  clientName  String
  location    String
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  totalBudget Decimal       @db.Decimal(15, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  surveys          SiteSurvey[]
  designFiles      DesignFile[]
  orders           Order[]
  expenses         SiteExpense[]
  snags            Snag[]
  boqItems         BOQItem[]
  scheduleItems    ProjectSchedule[]
  grns             GRNEntry[]
  auditChecklist   AuditItem[]
  dlpTickets       DLPTicket[]
  erpSync          ERPSync?
  activityLogs     ActivityLog[]
}

model SiteSurvey {
  id          String   @id @default(cuid())
  projectId   String
  conductedBy String
  surveyDate  DateTime
  notes       String?
  mediaUrls   String[]
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [conductedBy], references: [id])
}

model DesignFile {
  id           String           @id @default(cuid())
  projectId    String
  uploadedById String
  fileName     String
  fileUrl      String
  version      Int              @default(1)
  status       DesignFileStatus @default(PENDING_REVIEW)
  reviewNotes  String?
  uploadedAt   DateTime         @default(now())
  approvedAt   DateTime?

  project    Project @relation(fields: [projectId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
}

model Order {
  id          String        @id @default(cuid())
  projectId   String
  vendorName  String
  description String
  amount      Decimal       @db.Decimal(15, 2)
  status      InvoiceStatus @default(DRAFT)
  invoiceUrl  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project         @relation(fields: [projectId], references: [id])
  payments VendorPayment[]
}

// Purchase orders issued to vendors. Kept independent of the Project table
// (projectId is stored as a plain string, not a FK) because the ERP's projects
// are still a client-side demo (proj_1…) and aren't persisted yet — this lets POs
// live in the database today and stay valid once projects are migrated.
model PurchaseOrder {
  id                 String   @id @default(cuid())
  projectId          String
  projectName        String
  vendorName         String
  poNumber           String
  poValue            Decimal  @db.Decimal(15, 2)
  poFileName         String?
  // PO-document details captured by the generator, so a PO can be re-opened and
  // amended later with everything pre-filled.
  projectCode        String?
  subject            String?
  quotationRef       String?
  quotationDate      String?
  vendorAddress      String?
  vendorGstin        String?
  // Which Studio Masons GST branch the PO is billed from (see BILLING_BRANCHES).
  billingBranchId    String?
  commencement       String?
  completion         String?
  paymentTerms       String[]
  notes              Json?
  annexRemarks       Json?
  // Acceptance + advance stage (filled in after the PO is issued).
  acceptanceFileName String?
  advanceRequested   Decimal? @db.Decimal(15, 2)
  advanceApproved    Boolean  @default(false)
  advanceTdsPct      Decimal? @db.Decimal(5, 2)
  advancePayable     Decimal? @db.Decimal(15, 2)
  advanceConsumed    Decimal  @db.Decimal(15, 2) @default(0)
  // Fixed contract window — invoices for this vendor must fall inside it.
  fixedContract      Boolean  @default(false)
  contractStart      String?
  contractEnd        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lines PurchaseOrderLine[]

  @@index([projectId])
}

// A single service / scope line on a purchase order. poValue is the sum of these.
model PurchaseOrderLine {
  id          String  @id @default(cuid())
  poId        String
  service     String
  unit        String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(15, 2)
  supplyRate  Decimal? @db.Decimal(15, 2)
  installRate Decimal? @db.Decimal(15, 2)
  amount      Decimal @db.Decimal(15, 2)

  po PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
}

// A vendor invoice in the orders workflow. Kept independent of the Project/Order
// tables (project + vendor stored as plain strings) for the same reason as
// PurchaseOrder — projects are still a client-side demo. The id is the app-generated
// invoice number (e.g. SM-INV-4902), so it is not auto-defaulted.
model VendorInvoice {
  id                 String   @id
  vendor             String
  project            String
  amount             String
  amountNum          Decimal  @db.Decimal(15, 2)
  due                String
  status             String
  flagged            Boolean  @default(false)
  baseValue          Decimal? @db.Decimal(15, 2)
  sgstPct            Decimal? @db.Decimal(5, 2)
  cgstPct            Decimal? @db.Decimal(5, 2)
  igstPct            Decimal? @db.Decimal(5, 2)
  remarks            String?
  amountPayable      Decimal? @db.Decimal(15, 2)
  requestedAmount    Decimal? @db.Decimal(15, 2)
  advanceDeducted    Decimal? @db.Decimal(15, 2)
  tdsPct             Decimal? @db.Decimal(5, 2)
  retentionHeld      Boolean  @default(false)
  retentionAmount    Decimal? @db.Decimal(15, 2)
  // Up to 4 base-value lines, each with its own SGST/CGST/IGST %. Source of truth for
  // the invoice's tax breakdown; baseValue/sgstPct/cgstPct/igstPct keep the aggregate /
  // first-line values for legacy displays.
  taxLines              Json?
  // Flat charges added at accounts approval (freight/handling, etc.) — part of the TDS base.
  otherCharges          Decimal? @db.Decimal(15, 2)
  // When true, held retention may be paid before the 12-month window (bypassed).
  retentionEarlyRelease Boolean  @default(false)
  pmApprovedAt       String?
  pmApprovedBy       String?
  accountsApprovedBy String?
  fileName           String?
  createdAt          DateTime @default(now())
}

// A vendor payment request in the orders workflow. Independent of Project/Order
// for the same reason as VendorInvoice. The id is app-generated (e.g. PR-001).
model PaymentRequest {
  id                 String   @id
  vendor             String
  project            String
  amount             String
  amountNum          Decimal  @db.Decimal(15, 2)
  requested          String
  status             String
  notes              String?
  invoiceRef         String?
  priority           String?
  accountsApprovedBy String?
  paidBy             String?
  // Storage path of the uploaded invoice document (see documents.ts), or null.
  fileName           String?
  createdAt          DateTime @default(now())
}

model VendorPayment {
  id          String    @id @default(cuid())
  orderId     String
  amount      Decimal   @db.Decimal(15, 2)
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  notes       String?

  order Order @relation(fields: [orderId], references: [id])
}

model SiteExpense {
  id          String   @id @default(cuid())
  projectId   String
  category    String
  description String
  amount      Decimal  @db.Decimal(15, 2)
  receiptUrl  String?
  incurredAt  DateTime
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model Snag {
  id          String       @id @default(cuid())
  projectId   String
  assignedTo  String?
  title       String
  description String
  location    String
  photoUrls   String[]
  priority    SnagPriority @default(MEDIUM)
  status      SnagStatus   @default(OPEN)
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  project  Project @relation(fields: [projectId], references: [id])
  assignee User?   @relation("SnagAssignee", fields: [assignedTo], references: [id])
}

model BOQItem {
  id           String   @id @default(cuid())
  projectId    String
  workItem     String
  unit         String
  budgetedQty  Decimal  @db.Decimal(10, 2)
  installedQty Decimal  @db.Decimal(10, 2) @default(0)
  unitRate     Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectSchedule {
  id           String   @id @default(cuid())
  projectId    String
  taskName     String
  startDate    DateTime
  endDate      DateTime
  progress     Int      @default(0)
  parentTaskId String?

  project  Project           @relation(fields: [projectId], references: [id])
  parent   ProjectSchedule?  @relation("TaskChildren", fields: [parentTaskId], references: [id])
  children ProjectSchedule[] @relation("TaskChildren")
}

model GRNEntry {
  id           String   @id @default(cuid())
  projectId    String
  materialName String
  quantity     Decimal  @db.Decimal(10, 2)
  unit         String
  receivedAt   DateTime @default(now())
  supplierName String
  notes        String?

  project Project @relation(fields: [projectId], references: [id])
}

model AuditItem {
  id          String    @id @default(cuid())
  projectId   String
  checkItem   String
  passed      Boolean?
  notes       String?
  checkedAt   DateTime?
  signedOffBy String?

  project Project @relation(fields: [projectId], references: [id])
}

model DLPTicket {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  amcDueDate  DateTime?

  project Project @relation(fields: [projectId], references: [id])
}

model ERPSync {
  id             String        @id @default(cuid())
  projectId      String        @unique
  lastSyncAt     DateTime?
  status         ERPSyncStatus @default(PENDING)
  scopeDataSent  Boolean       @default(false)
  poCreated      Boolean       @default(false)
  errorLog       String?

  project Project @relation(fields: [projectId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// App-shaped, denormalized tables that back the UI directly. Project is stored as
// a name string (not a FK) to match the client-side project selector, the same
// pattern used by PurchaseOrder / VendorInvoice. These are the source of truth for
// the pages — nothing in the UI is hardcoded.
// ─────────────────────────────────────────────────────────────────────────────

// The project selector + dashboard. id keeps the legacy "proj_N" values referenced
// by PurchaseOrder.projectId.
model AppProject {
  id         String  @id
  name       String
  clientName String
  location   String
  pct        Int     @default(0)
  engineer   String
  isDelayed  Boolean @default(false)
  sortOrder  Int     @default(0)
}

// Team members used across assignee / engineer dropdowns and Settings.
model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

// Dashboard recent-activity feed.
model ActivityEntry {
  id     String   @id
  icon   String
  color  String
  route  String
  text   String
  bold   String
  detail String
  by     String
  at     DateTime
}

model SnagEntry {
  id           String   @id
  projectName  String
  title        String
  category     String   @default("Civil & Structure")
  priority     String
  status       String
  description  String
  assignee     String
  displayTime  String
  evidenceName String?
  evidenceUrl  String?  @db.Text
  accent       Boolean  @default(false)
  closed       Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model SnagComment {
  id        String   @id
  snagId    String
  author    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([snagId])
}

model DesignDoc {
  id          String  @id
  icon        String
  name        String
  meta        String
  by          String
  date        String
  status      String
  feedback    String?
  // Per-project association + optional link to a Project-Tracker design stage
  // (7, 9 or 11). When linked, the stage's status auto-reflects these docs.
  projectName String  @default("")
  stageNumber Int?
  sortOrder   Int     @default(0)
}

model SurveyEntry {
  id           String   @id
  projectName  String
  date         String
  conductor    String
  status       String
  photos       Int      @default(0)
  type         String
  notes        String
  checkedItems String[]
  sortOrder    Int      @default(0)
}

// Standard survey checklist template (categories with their item labels).
model SurveyChecklistCategory {
  id        String   @id @default(cuid())
  category  String
  items     String[]
  sortOrder Int      @default(0)
}

model AuditEntry {
  id        String  @id @default(cuid())
  section   String
  label     String
  signed    Boolean @default(false)
  signedBy  String?
  date      String?
  sortOrder Int     @default(0)
}

// Per-project audit progress cards shown alongside the checklist.
model AuditProjectRow {
  id         String @id @default(cuid())
  name       String
  completion Int    @default(0)
  status     String
  sortOrder  Int    @default(0)
}

model DlpTicketEntry {
  id           String  @id
  projectName  String
  title        String
  category     String
  reportedDate String
  dueDate      String
  assignee     String
  status       String
  priority     String
  amcDue       String?
  sortOrder    Int     @default(0)
}

model AmcScheduleEntry {
  id          String  @id @default(cuid())
  service     String
  projectName String
  nextDue     String
  frequency   String
  overdue     Boolean @default(false)
  sortOrder   Int     @default(0)
}

// Site-progress BOQ breakdown (demo set is global, not per-project).
model BoqProgressItem {
  id        String @id @default(cuid())
  name      String
  category  String
  status    String
  budgeted  String
  installed String
  pct       Int    @default(0)
  sortOrder Int    @default(0)
}

model SiteExpenseEntry {
  id                String   @id
  category          String
  description       String
  projectName       String
  amount            String
  amountNum         Decimal  @db.Decimal(15, 2)
  date              String
  by                String
  status            String
  pmApprovedBy      String?
  billingApprovedBy String?
  accountsApprovedBy String?
  // Storage path of the uploaded voucher document (see documents.ts), or null.
  fileName          String?
  sortOrder         Int      @default(0)
}

model VendorScopeEntry {
  id          String  @id
  vendor      String
  projectName String
  scope       String
  progress    Int     @default(0)
  status      String
  dueDate     String
  sortOrder   Int     @default(0)
}

model QualityInspection {
  id          String  @id
  projectName String
  area        String
  category    String
  inspector   String
  date        String
  result      String
  score       Int     @default(0)
  remarks     String?
  workType    String?
  contractor  String?
  drawingNo   String?
  // Snapshot of the filled checklist at submit time:
  // [{ name, items: [{ label, linked, answer, remarks }] }]  answer: "" | "yes" | "no" | "na"
  responses   Json?
  sortOrder   Int     @default(0)
}

// A work-type checklist (e.g. "Tile Laying", "MCB & DB") selectable when starting
// an inspection. Imported from the SMPL quality-control workbook.
model QualityChecklistTemplate {
  id         String                     @id @default(cuid())
  name       String
  discipline String
  categories QualityChecklistCategory[]
  sortOrder  Int                        @default(0)
}

// A section within a template — items stored as JSON [{ label, linked }].
model QualityChecklistCategory {
  id         String                   @id @default(cuid())
  templateId String
  template   QualityChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  items      Json
  sortOrder  Int                      @default(0)
}

model ErpIntegration {
  id            String  @id
  name          String
  category      String
  description   String
  icon          String
  iconBg        String
  iconColor     String
  status        String
  lastSync      String?
  recordsSynced Int     @default(0)
  enabled       Boolean @default(false)
  apiKey        String  @default("")
  endpoint      String  @default("")
  sortOrder     Int     @default(0)
}

model ErpSyncLog {
  id          String @id
  integration String
  event       String
  status      String
  records     Int    @default(0)
  timestamp   String
  duration    String
  sortOrder   Int    @default(0)
}

model ErpFieldMapping {
  id            String @id @default(cuid())
  erpField      String
  externalField String
  integration   String
  type          String
  direction     String
  sortOrder     Int    @default(0)
}

model ErpWebhook {
  id            String   @id
  name          String
  url           String
  events        String[]
  status        String
  lastTriggered String
  successRate   Int      @default(0)
  sortOrder     Int      @default(0)
}

// ─────────────────────────────────────────────────────────────────────────────
// Project Tracker — the 14-stage pipeline, its per-project progress, and the
// Concept/Project team assignment. projectId is a plain "proj_N" string (no FK),
// matching the other app-shaped tables.
// ─────────────────────────────────────────────────────────────────────────────

// The 14 master stages (from the project-kickoff breakdown). Seeded once and
// shared by every project; ProjectStage holds the per-project status.
model ProjectStageTemplate {
  stageNumber Int       @id
  activity    String
  output      String
  checkpoint  String
  zone        StageZone
  // Workflow phase from the deck: Initiation | Design Development | Approval + GFC | Execution Control.
  phase       String    @default("")
  // Approval-gate metadata (deck's 7 gates). gateNumber is null for non-gate stages.
  gateNumber  Int?
  gateCheck   String?
  gateOwner   String?
  gateOutput  String?
  // When set, this stage's status is auto-reflected from another module instead
  // of being advanced manually ("survey" = Site Survey). null = manual.
  autoSource  String?
  sortOrder   Int       @default(0)
}

// One row per project × stage — the editable progress record.
model ProjectStage {
  id          String      @id @default(cuid())
  projectId   String
  stageNumber Int
  status      StageStatus @default(NOT_STARTED)
  // Dashboard columns from Action 2 ("minimum dashboard columns").
  ownerId     String?     // main owner for this deliverable (defaults to the zone lead)
  plannedDate DateTime?
  actualDate  DateTime?
  dependency  String?     // pending input from client / MEP / QS / vendor / management
  risk        String?
  nextAction  String?
  signedOffBy String?
  notes       String?
  completedAt DateTime?
  // A status move requested by a lead/vice that awaits a higher post's approval.
  pendingStatus StageStatus?
  pendingBy     String?     // requester display name
  pendingById   String?     // requester user id (so they can cancel their own request)
  pendingRank   Int?        // authority rank of the requester (1 vice, 2 lead)
  pendingAt     DateTime?
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, stageNumber])
  @@index([projectId])
}

// Per-project team: the single locked lead for each zone (sole major-decision
// maker — once set it cannot be reassigned) plus any number of helpers, and the
// handoff stamp recorded when control passes from Concept to Project.
model ProjectTeam {
  projectId         String   @id
  conceptLeadId     String?
  conceptViceLeadId String?
  projectLeadId     String?
  projectViceLeadId String?
  conceptHelpers    String[]
  projectHelpers    String[]
  handoffAt         DateTime?
  handoffBy         String?
  updatedAt         DateTime @updatedAt
}

// Drawing Issue Register (deck Action 2): revision number, issue date, recipients
// and status for every drawing released on a project.
model DrawingIssue {
  id          String   @id @default(cuid())
  projectId   String
  drawingNo   String
  title       String
  revision    String   @default("R0")
  issueDate   DateTime
  recipients  String   @default("")
  purpose     String?
  status      String   @default("Issued")
  issuedBy    String   @default("")
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// Change / Risk Tracker (deck Action 2): post-approval changes, cost impact and
// escalation route, with a status and priority for leadership review.
model ChangeItem {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  description     String?
  raisedDate      DateTime
  costImpact      String   @default("")
  escalationRoute String   @default("")
  owner           String?
  priority        String   @default("Medium")
  status          String   @default("Open")
  createdAt       DateTime @default(now())

  @@index([projectId])
}

// ── Procurement → Finance workflow ────────────────────────────────
// The Budget BOQ released by the Senior QS Engineer — the "bible" that gates every
// Purchase Intent on the project. One released budget per project; while DRAFT it
// can be re-imported, once RELEASED its quantities are locked. projectId is a plain
// string (not a FK) to match PurchaseOrder — projects are still a client-side demo.
model BudgetBoq {
  id          String          @id @default(cuid())
  projectId   String
  projectName String
  fileName    String?
  status      String          @default("DRAFT") // DRAFT | RELEASED
  releasedBy  String?
  releasedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       BudgetBoqLine[]

  @@index([projectId])
}

// A single budget line. budgetedQty is the cap; committedQty accumulates as POs are
// released against this item, so remaining = budgetedQty − committedQty drives the
// quantity restriction (including the partial draw-down case). packageName is the
// procurement team's package-wise split, editable after release.
model BudgetBoqLine {
  id           String  @id @default(cuid())
  boqId        String
  packageName  String?
  item         String
  unit         String
  budgetedQty  Decimal @db.Decimal(12, 2)
  // `rate` is the effective combined rate (supply + installation where the BOQ
  // splits them). supplyRate / installRate keep the split when present.
  rate         Decimal @db.Decimal(15, 2)
  supplyRate   Decimal? @db.Decimal(15, 2)
  installRate  Decimal? @db.Decimal(15, 2)
  amount       Decimal @db.Decimal(15, 2)
  committedQty Decimal @db.Decimal(12, 2) @default(0)

  boq BudgetBoq @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@index([boqId])
}

// A Purchase Intent — the spine of the workflow. Raised by the Project Manager,
// approved by the Project Director, quoted/compared by the Procurement Manager,
// verified by Finance, then released as a PO. limitExceeded is set at submit time
// when any line is over budget or a new item; the PD must set pdReconfirmed to
// approve such an intent.
model PurchaseIntent {
  id                      String              @id @default(cuid())
  projectId               String
  projectName             String
  intentNumber            String
  packageName             String?
  raisedBy                String
  status                  IntentStatus        @default(PENDING_PD_APPROVAL)
  limitExceeded           Boolean             @default(false)
  pdApprovedBy            String?
  pdApprovedAt            DateTime?
  pdReconfirmed           Boolean             @default(false)
  pdRejectReason          String?
  comparisonFileName      String?
  chosenQuoteId           String?
  chosenVendorBoqFileName String?
  financeApprovedBy       String?
  financeApprovedAt       DateTime?
  financeNotes            String?
  releasedPoId            String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  lines                   PurchaseIntentLine[]
  quotes                  VendorQuote[]

  @@index([projectId])
}

// A requested item on an intent. budgetLineId links to the matched BudgetBoqLine
// (null ⇒ new item not in the budget). exceedsBudget is set when requestedQty is
// above the remaining budgeted qty; availableQtyAtSubmit snapshots that remaining.
model PurchaseIntentLine {
  id                   String  @id @default(cuid())
  intentId             String
  budgetLineId         String?
  item                 String
  unit                 String
  requestedQty         Decimal @db.Decimal(12, 2)
  isNewItem            Boolean @default(false)
  exceedsBudget        Boolean @default(false)
  availableQtyAtSubmit Decimal? @db.Decimal(12, 2)

  intent PurchaseIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
}

// A vendor quote collected by the Procurement Manager for an intent. The chosen one
// (PurchaseIntent.chosenQuoteId) is the source of the released PO; Finance verifies
// its vendor financial details (gstin / bank).
model VendorQuote {
  id               String           @id @default(cuid())
  intentId         String
  vendorName       String
  vendorGstin      String?
  vendorBankDetails String?
  fileName         String?
  totalValue       Decimal          @db.Decimal(15, 2)
  createdAt        DateTime         @default(now())
  lines            VendorQuoteLine[]

  intent PurchaseIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
}

model VendorQuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  item        String
  unit        String
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(15, 2)
  supplyRate  Decimal? @db.Decimal(15, 2)
  installRate Decimal? @db.Decimal(15, 2)
  amount      Decimal @db.Decimal(15, 2)

  quote VendorQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}
